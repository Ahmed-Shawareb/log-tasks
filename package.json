{
  "name": "log-tasks",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "db:start": "node scripts/db-server.mjs",
    "dev": "next dev -p 3100",
    "build": "prisma generate && next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force --skip-seed && npm run seed",
    "seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "setup": "prisma migrate deploy && prisma generate && npm run seed",
    "create-admin": "tsx --env-file-if-exists=.env scripts/create-admin.ts",
    "dev-reset-password": "tsx --env-file-if-exists=.env scripts/dev-reset-password.ts",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "vercel-build": "node scripts/vercel-build.mjs",
    "provision-users": "tsx --env-file-if-exists=.env scripts/provision-users.ts",
    "purge-test-data": "tsx --env-file-if-exists=.env scripts/purge-test-data.ts"
  },
  "prisma": {
    "seed": "tsx --env-file-if-exists=.env prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/list": "^6.1.22",
    "@fullcalendar/react": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.22",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "^16.4.2",
    "prisma": "^6.19.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
