# ── Database ───────────────────────────────────────────────
# Local: embedded Postgres started by `npm run db:start` (port 5433).
# Supabase: DATABASE_URL = transaction pooler (port 6543, ?pgbouncer=true&connection_limit=1)
#           DIRECT_URL   = session/direct connection (port 5432) — used by migrations.
DATABASE_URL="postgresql://log:log_local_dev@localhost:5433/log_dev"
DIRECT_URL="postgresql://log:log_local_dev@localhost:5433/log_dev"

# ── App ────────────────────────────────────────────────────
# development | test | preview | production — predictable test accounts are refused when production.
APP_ENV="development"
APP_URL="http://localhost:3100"
APP_TIMEZONE="Africa/Cairo"
# 32+ random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me"
# Protects /api/cron/* (Vercel Cron sends it as a Bearer token)
CRON_SECRET="change-me"

# ── File storage ───────────────────────────────────────────
# Leave empty to store uploads in ./storage (local dev). Set both for Supabase Storage (private bucket).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="log-attachments"
MAX_UPLOAD_MB="4"

# Only for an isolated preview/test deployment: allow `npm run seed` to create the shared test accounts.
ALLOW_TEST_ACCOUNTS="false"
